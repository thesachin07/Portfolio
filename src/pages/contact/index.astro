---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';

const contactInfo = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { label: 'Phone', value: site.phone, href: `tel:${site.phone.replace(/\s/g, '')}` },
  { label: 'Location', value: site.location, href: 'https://maps.google.com' },
];

const socials = [
  { label: 'GitHub', href: site.github },
  { label: 'LinkedIn', href: site.linkedin },
  { label: 'Twitter', href: site.twitter },
];
---

<Layout title={`Contact - ${site.name}`} description="Get in touch with Sachin Kumar.">
  <section class="content-wrap pt-20 pb-16">
    <p class="eyebrow mb-3">Contact</p>
    <h1 class="text-4xl sm:text-6xl font-bold text-[var(--color-ink)] max-w-2xl">
      Let's build something worth shipping.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-[var(--color-ink-muted)] leading-relaxed">
      Have a project, a role, or a hard frontend problem? Send a message &mdash; I typically
      reply within 24 hours.
    </p>
  </section>

  <section class="content-wrap pb-28">
    <div class="grid lg:grid-cols-2 gap-12">
      <div class="space-y-8">
        <div class="space-y-4">
          {contactInfo.map((info) => (
            <a
              href={info.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-5 card hover:border-[var(--color-accent)]/50 transition-colors group"
            >
              <div>
                <p class="text-xs text-[var(--color-ink-faint)] uppercase tracking-wide mb-1">{info.label}</p>
                <p class="font-medium text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">{info.value}</p>
              </div>
              <span class="text-[var(--color-ink-faint)]">&rarr;</span>
            </a>
          ))}
        </div>

        <div>
          <p class="eyebrow mb-4">Elsewhere</p>
          <div class="flex gap-3">
            {socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 rounded-full text-sm border border-[var(--color-border)] text-[var(--color-ink-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors"
              >
                {s.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="card p-8">
        <h2 class="text-xl font-semibold text-[var(--color-ink)] mb-6">Send a message</h2>
        <form id="contact-form" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-[var(--color-ink-muted)] mb-2" for="name">Your name</label>
            <input id="name" name="name" type="text" required
              class="w-full px-4 py-3 rounded-md bg-[var(--color-bg-raised)] border border-[var(--color-border)] text-[var(--color-ink)] outline-none focus:border-[var(--color-accent)] transition-colors" />
          </div>
          <div>
            <label class="block text-sm font-medium text-[var(--color-ink-muted)] mb-2" for="email">Your email</label>
            <input id="email" name="email" type="email" required
              class="w-full px-4 py-3 rounded-md bg-[var(--color-bg-raised)] border border-[var(--color-border)] text-[var(--color-ink)] outline-none focus:border-[var(--color-accent)] transition-colors" />
          </div>
          <div>
            <label class="block text-sm font-medium text-[var(--color-ink-muted)] mb-2" for="subject">Subject</label>
            <input id="subject" name="subject" type="text" required
              class="w-full px-4 py-3 rounded-md bg-[var(--color-bg-raised)] border border-[var(--color-border)] text-[var(--color-ink)] outline-none focus:border-[var(--color-accent)] transition-colors" />
          </div>
          <div>
            <label class="block text-sm font-medium text-[var(--color-ink-muted)] mb-2" for="message">Message</label>
            <textarea id="message" name="message" rows="5" required
              class="w-full px-4 py-3 rounded-md bg-[var(--color-bg-raised)] border border-[var(--color-border)] text-[var(--color-ink)] outline-none focus:border-[var(--color-accent)] transition-colors resize-none"></textarea>
          </div>
          <button type="submit"
            class="w-full px-6 py-3 rounded-md bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold hover:bg-[var(--color-accent-hover)] transition-colors">
            Send message
          </button>
          <p id="form-note" class="text-sm text-[var(--color-ink-faint)] hidden"></p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ email: site.email }}>
  const form = document.getElementById('contact-form');
  const note = document.getElementById('form-note');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const subject = encodeURIComponent(String(data.get('subject') || 'Portfolio contact'));
    const body = encodeURIComponent(
      `From: ${data.get('name')} (${data.get('email')})\n\n${data.get('message')}`
    );
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
    if (note) {
      note.textContent = 'Opening your email client to send this message...';
      note.classList.remove('hidden');
    }
  });
</script>
