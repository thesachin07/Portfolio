---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, stats, projects, timeline, } from '../data/site';

const featured = projects.slice(0, 3);
---

<Layout title={`${site.name} - ${site.role}`}>
  <!-- Hero -->
  <section class="content-wrap pt-20 pb-24">
    <p class="eyebrow mb-5 fade-up">{site.role} &middot; {site.location}</p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.08] max-w-4xl text-[var(--color-ink)] fade-up" style="animation-delay:.05s">
      {site.headline}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-[var(--color-ink-muted)] leading-relaxed fade-up" style="animation-delay:.1s">
      {site.intro}
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-4 fade-up" style="animation-delay:.15s">
      <a
        href="/work/"
        class="inline-flex items-center px-5 py-2.5 rounded-md bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold hover:bg-[var(--color-accent-hover)] transition-colors"
      >
        See my work
      </a>
      <a
        href="/resume/"
        class="inline-flex items-center px-5 py-2.5 rounded-md border border-[var(--color-border)] text-[var(--color-ink)] font-medium hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
      >
        Read the resume
      </a>
    </div>

    <div class="mt-8 flex items-center gap-5 text-sm text-[var(--color-ink-muted)] fade-up" style="animation-delay:.2s">
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-ink)]">GitHub</a>
      <span class="text-[var(--color-border)]">&middot;</span>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-ink)]">LinkedIn</a>
      <span class="text-[var(--color-border)]">&middot;</span>
      <a href={`mailto:${site.email}`} class="hover:text-[var(--color-ink)]">Email</a>
    </div>
  </section>

  <section class="content-wrap pb-24">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 border-t border-[var(--color-border-soft)] pt-12">
      {stats.map((s) => (
        <div>
          <p class="text-3xl sm:text-4xl font-semibold text-[var(--color-accent)]">{s.value}</p>
          <p class="mt-2 text-sm text-[var(--color-ink-muted)] leading-snug">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

 
  <section class="content-wrap pb-24">
    <p class="eyebrow mb-3">Selected Work</p>
    <h2 class="text-3xl sm:text-4xl font-semibold text-[var(--color-ink)] max-w-2xl">
      Projects, not just a tech-stack list.
    </h2>
    <p class="mt-4 max-w-2xl text-[var(--color-ink-muted)] leading-relaxed">
      A handful of things I've built end to end &mdash; from UI to the services behind it.
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>

    <div class="mt-10">
      <a href="/work/" class="text-sm font-semibold text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]">
        View all projects &rarr;
      </a>
    </div>
  </section>

  <!-- Experience preview -->
  <section class="content-wrap pb-24">
  <p class="eyebrow mb-3">Experience</p>

  <h2 class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] max-w-2xl">
    Where the work happened.
  </h2>

  <div class="mt-12 space-y-6">
    {timeline.map((item) => (
      <div class="card p-6 sm:p-7">

        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
          <div>
            <h3 class="font-semibold text-[var(--color-ink)]">
              {item.title}
            </h3>

            <p class="text-sm text-[var(--color-ink-muted)] mt-1">
              {item.org}
            </p>
          </div>

          <p class="text-sm text-[var(--color-accent)] whitespace-nowrap font-medium">
            {item.period}
          </p>
        </div>

   
        {item.problem && (
          <div class="mt-6">
            <p class="eyebrow mb-2">Problem</p>

            <p class="text-sm sm:text-base text-[var(--color-ink-muted)] leading-relaxed max-w-4xl">
              {item.problem}
            </p>
          </div>
        )}

      
        {item.approach && (
          <div class="mt-6">
            <p class="eyebrow mb-2">Approach</p>

            <ul class="space-y-2 text-sm sm:text-base text-[var(--color-ink-muted)] leading-relaxed">
              {item.approach.map((point) => (
                <li class="pl-5 relative">
                  {point}
                </li>
              ))}
            </ul>
          </div>
        )}

      
        {item.outcomes && (
          <div class="mt-6">
            <p class="eyebrow mb-2">Outcomes</p>

            <ul class="space-y-2 text-sm sm:text-base text-[var(--color-ink-muted)] leading-relaxed">
              {item.outcomes.map((point) => (
                <li class="pl-5 relative">
                  {point}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Stack -->
        {item.stack && (
          <div class="mt-6">
            <p class="eyebrow mb-3">Stack</p>

            <div class="flex flex-wrap gap-2">
              {item.stack.map((tech) => (
                <span class="border border-[var(--color-border)] px-3 py-1 text-xs font-medium text-[var(--color-ink)]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        )}

      </div>
    ))}
  </div>
</section>

  <!-- CTA -->
  <section class="content-wrap pb-28">
    <div class="card p-10 sm:p-14 text-center">
      <p class="eyebrow mb-4">Available for opportunities</p>
      <h2 class="text-3xl sm:text-4xl font-semibold text-[var(--color-ink)] max-w-2xl mx-auto">
        Bring me a UI problem worth solving properly.
      </h2>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/contact/"
          class="inline-flex items-center px-6 py-3 rounded-md bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold hover:bg-[var(--color-accent-hover)] transition-colors"
        >
          Start a conversation
        </a>
        <a
          href="/resume/"
          class="inline-flex items-center px-6 py-3 rounded-md border border-[var(--color-border)] text-[var(--color-ink)] font-medium hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
        >
          View resume
        </a>
      </div>
    </div>
  </section>
</Layout>
