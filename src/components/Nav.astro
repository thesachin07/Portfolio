---
import { site, nav } from '../data/site';

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-[var(--color-bg)]/80 border-b border-[var(--color-border-soft)]">
  <div class="content-wrap flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2 font-extrabold text-[var(--color-ink)]">
      <span class="w-8 h-8 rounded-full bg-[var(--color-accent-soft)] border border-[var(--color-accent)]/40 text-[var(--color-accent)] flex items-center justify-center text-xs font-bold">
        {site.initials}
      </span>
      <span>{site.name}</span>
    </a>

    <nav class="hidden sm:flex items-center gap-1 text-sm">
      {nav.map((item) => {
        const active = current === item.href || (item.href !== '/' && current.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-2 rounded-md transition-colors font-extrabold hover:text-[var(--color-accent)] ${
              active
                ? 'text-[var(--color-ink)]'
                : 'text-[var(--color-ink-muted)] hover:text-[var(--color-accent)]'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <a
      href="/contact/"
      class="hidden sm:inline-flex items-center text-sm font-extrabold px-4 py-2 rounded-md border border-[var(--color-border)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
    >
      Let's talk
    </a>

    <details class="sm:hidden relative">
      <summary class="list-none cursor-pointer p-2 text-[var(--color-ink-muted)]">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <div class="absolute right-0 mt-2 w-48 card p-2 flex flex-col gap-1 shadow-xl">
        {nav.map((item) => (
          <a href={item.href} class="px-3 py-2 rounded-md text-sm text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] hover:bg-[var(--color-bg-raised)]">
            {item.label}
          </a>
        ))}
      </div>
    </details>
  </div>
</header>
